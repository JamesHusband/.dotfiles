{
  "compilerOptions": {
    "declaration": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node16"
  },
  "include": ["./src/**/*", "./types/**/*"],
  "exclude": ["./src/**/*.spec.ts", "./types/**/*.spec.ts"],
  "ts-node": {
    "esm": true
  }
}
